POSTGRES_DB=kpi_system
POSTGRES_USER=kpi_app
POSTGRES_PASSWORD=change_me_for_local_development
BACKEND_PORT=8080
FRONTEND_PORT=4000

# Google Workspace Sign-In (Optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=yourcompany.com
# ── Google SMTP Configuration ──────────────────────────────────────────────────
# Dùng Gmail thông thường hoặc Workspace với App Password (Khuyên dùng): smtp.gmail.com
# Dùng Google Workspace SMTP Relay (Yêu cầu cấu hình IP whitelist trên Google Admin): smtp-relay.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_ADDRESS=no-reply@yourdomain.com
SMTP_FROM_NAME="Employee Performance Evaluation System"
SMTP_THROTTLE_PER_MINUTE=60
PORTAL_BASE_URL=http://localhost:5173

# ── Email Provider Selection ─────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp    → use SMTP credentials above (Docker/local, default)
# EMAIL_PROVIDER=resend  → use Resend HTTP API (required for Render Free, where SMTP ports are blocked)
EMAIL_PROVIDER=smtp

# ── Resend API (required when EMAIL_PROVIDER=resend) ─────────────────────────
# Sign up free at https://resend.com — 3,000 emails/month, 100/day
# For testing without domain verification, use: onboarding@resend.dev as RESEND_FROM_ADDRESS
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_ADDRESS=onboarding@resend.dev