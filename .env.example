POSTGRES_DB=kpi_system
POSTGRES_USER=kpi_app
POSTGRES_PASSWORD=change_me_for_local_development
BACKEND_PORT=8080
FRONTEND_PORT=4000

# Google Workspace Sign-In (Optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=yourcompany.com
# ── Google SMTP Configuration ──────────────────────────────────────────────────
# Dùng Gmail thông thường hoặc Workspace với App Password (Khuyên dùng): smtp.gmail.com
# Dùng Google Workspace SMTP Relay (Yêu cầu cấu hình IP whitelist trên Google Admin): smtp-relay.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_ADDRESS=no-reply@yourdomain.com
SMTP_FROM_NAME="Employee Performance Evaluation System"
SMTP_THROTTLE_PER_MINUTE=60
PORTAL_BASE_URL=http://localhost:5173

# ── Email Provider Selection ─────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp    → use SMTP credentials above (Docker/local, default)
# EMAIL_PROVIDER=gmail   → use Google Gmail REST API via HTTPS port 443 (required for Render Free, where SMTP ports 25/465/587 are blocked)
EMAIL_PROVIDER=smtp

# ── Gmail API OAuth2 (required when EMAIL_PROVIDER=gmail) ────────────────────
# Tái sử dụng GOOGLE_CLIENT_ID ở trên (chỉ cần thêm redirect URI https://developers.google.com/oauthplayground và enable Gmail API trên Google Cloud Console)
# 1. Lấy Client Secret của GOOGLE_CLIENT_ID đó điền vào GMAIL_CLIENT_SECRET
# 2. Vào Google OAuth Playground (https://developers.google.com/oauthplayground) để lấy Refresh Token với scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth2-refresh-token
GMAIL_USER=your-email@gmail.com
# ── Individual evaluation cycles ───────────────────────────────────────────────
# IANA timezone used to compute "today" for the upcoming batch cycle window.
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Weeks ahead in which a DRAFT batch cycle counts as upcoming (review due + individual cycle warnings).
BATCH_CYCLE_LEAD_TIME_WEEKS=4
