{
  "name": "kpi-system-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:migrations": "vitest run src/shared/database/migrations.test.ts",
    "seed": "tsx src/modules/iam/infrastructure/seed.ts",
    "migrate:up": "node-pg-migrate up -m migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m migrations --database-url-var DATABASE_URL",
    "migrate:up:tsx": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --database-url-var DATABASE_URL",
    "migrate:down:tsx": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations --database-url-var DATABASE_URL"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "node-pg-migrate": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
